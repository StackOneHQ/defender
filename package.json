{
    "name": "@stackone/defender",
    "version": "0.9.0",
    "description": "Prompt injection defense framework for AI tool-calling",
    "homepage": "https://www.stackone.com/platform/prompt-injection-guard/?utm_source=npm&utm_medium=listing&utm_campaign=homepage",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/StackOneHQ/defender.git"
    },
    "bugs": {
        "url": "https://github.com/StackOneHQ/defender/issues"
    },
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.cts",
    "files": [
        "dist",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.cts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "clean": "rimraf dist",
        "prebuild": "pnpm clean",
        "build": "tsc --noEmit --project tsconfig.json && tsdown --env.NODE_ENV=production --minify && pnpm copy-models",
        "prebuild:dev": "pnpm clean",
        "build:dev": "tsc --noEmit --project tsconfig.json && tsdown --env.NODE_ENV=development && pnpm copy-models",
        "copy-models": "node scripts/copy-models.cjs",
        "code:format": "biome format ./src ./examples",
        "code:format:fix": "biome format --write ./src ./examples",
        "code:lint": "biome lint --error-on-warnings ./src",
        "code:lint:fix": "biome lint --write ./src",
        "code:check": "biome check ./src ./examples",
        "code:check:fix": "biome check --write ./src ./examples",
        "lint": "pnpm code:check",
        "lint:fix": "pnpm code:check:fix",
        "test": "FORCE_COLOR=1 vitest run",
        "test:watch": "FORCE_COLOR=1 vitest watch --silent",
        "test:typecheck": "tsc --noEmit --project tsconfig.tests.json",
        "example": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON",
        "examples:typecheck": "tsc --noEmit --project examples/tsconfig.json",
        "examples:smoke": "for f in examples/0*.ts; do echo \"== $f\"; node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"$f\" || exit 1; done",
        "prepublishOnly": "pnpm build",
        "publish-release": "pnpm publish --access=public --no-git-checks"
    },
    "keywords": [
        "prompt-injection",
        "ai-safety",
        "llm",
        "guardrails",
        "security"
    ],
    "author": "StackOne",
    "license": "Apache-2.0",
    "packageManager": "pnpm@11.1.1",
    "engines": {
        "node": ">=22"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "22.20.0",
            "onFail": "download"
        }
    },
    "dependencies": {
        "nanoid": "3.3.18"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.5",
        "@huggingface/transformers": "3.8.1",
        "fasttext.wasm": "^1.0.1",
        "onnxruntime-node": "1.21.0",
        "rimraf": "^6.1.3",
        "tsdown": "^0.21.0-beta.2",
        "typescript": "7.0.2",
        "vitest": "^4.0.18"
    },
    "peerDependencies": {
        "@huggingface/transformers": "^3.0.0",
        "fasttext.wasm": "^1.0.0",
        "onnxruntime-node": ">=1.16.0"
    },
    "peerDependenciesMeta": {
        "@huggingface/transformers": {
            "optional": true
        },
        "fasttext.wasm": {
            "optional": true
        },
        "onnxruntime-node": {
            "optional": true
        }
    }
}
