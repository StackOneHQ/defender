{
	"version": 1,
	"area": "sfe-fallback",
	"description": "When SFE keeps no text Tier 2 would score, Tier 2 scores the original payload's text instead, leaving out single printable-ASCII tokens such as URLs and IDs (a token that joins 4+ alphabetic words with - _ or + is still scored). A scripted SFE drops the listed top-level keys (\"*\" drops all), except that a string value with 3+ words is always kept. highRiskThreshold 0 makes any scored string block.",
	"cases": [
		{
			"id": "all-dropped-falls-back",
			"description": "Every field dropped: the original is scored, so it blocks.",
			"requiresTier2": true,
			"input": {
				"payload": {
					"id": "rec_1",
					"notes": "Review contract."
				},
				"dropKeys": [
					"*"
				]
			},
			"expect": {
				"allowed": false,
				"fieldsDropped": [
					"id",
					"notes"
				],
				"sfeFallback": true,
				"tier2SkipReason": null
			}
		},
		{
			"id": "list-all-dropped-falls-back",
			"requiresTier2": true,
			"input": {
				"payload": [
					{
						"notes": "First record."
					},
					{
						"notes": "Second record."
					}
				],
				"dropKeys": [
					"*"
				]
			},
			"expect": {
				"allowed": false,
				"fieldsDropped": [
					"notes"
				],
				"sfeFallback": true,
				"tier2SkipReason": null
			}
		},
		{
			"id": "short-kept-falls-back",
			"description": "SFE keeps only a string below minTextLength: the fallback runs.",
			"requiresTier2": true,
			"input": {
				"payload": {
					"status": "ok",
					"notes": "Review contract."
				},
				"dropKeys": [
					"notes"
				]
			},
			"expect": {
				"allowed": false,
				"fieldsDropped": [
					"notes"
				],
				"sfeFallback": true,
				"tier2SkipReason": null
			}
		},
		{
			"id": "normalised-short-kept-falls-back",
			"description": "The kept string is long enough raw but below minTextLength after Tier 2's normalisation: the fallback runs.",
			"requiresTier2": true,
			"input": {
				"payload": {
					"status": "Café café",
					"notes": "Review contract."
				},
				"dropKeys": [
					"notes"
				]
			},
			"expect": {
				"allowed": false,
				"fieldsDropped": [
					"notes"
				],
				"sfeFallback": true,
				"tier2SkipReason": null
			}
		},
		{
			"id": "cjk-falls-back",
			"description": "Text without ASCII spaces is still scored.",
			"requiresTier2": true,
			"input": {
				"payload": {
					"notes": "金曜日までに添付の契約書を確認してください。"
				},
				"dropKeys": [
					"*"
				]
			},
			"expect": {
				"allowed": false,
				"fieldsDropped": [
					"notes"
				],
				"sfeFallback": true,
				"tier2SkipReason": null
			}
		},
		{
			"id": "astral-kept-counts-utf16",
			"description": "minTextLength counts UTF-16 units: 5 astral CJK characters are 10 units, so the kept string is scorable and there is no fallback.",
			"requiresTier2": true,
			"input": {
				"payload": {
					"status": "𠀀𠀁𠀂𠀃𠀄",
					"notes": "Review contract."
				},
				"dropKeys": [
					"notes"
				]
			},
			"expect": {
				"allowed": false,
				"fieldsDropped": [
					"notes"
				],
				"sfeFallback": false,
				"tier2SkipReason": null
			}
		},
		{
			"id": "some-kept-no-fallback",
			"description": "SFE keeps a text field: no fallback, the kept text is scored.",
			"requiresTier2": true,
			"input": {
				"payload": {
					"id": "rec_1",
					"notes": "Review contract."
				},
				"dropKeys": [
					"id"
				]
			},
			"expect": {
				"allowed": false,
				"fieldsDropped": [
					"id"
				],
				"sfeFallback": false,
				"tier2SkipReason": null
			}
		},
		{
			"id": "nothing-dropped-no-fallback",
			"requiresTier2": true,
			"input": {
				"payload": {
					"notes": "Review contract."
				},
				"dropKeys": []
			},
			"expect": {
				"allowed": false,
				"fieldsDropped": [],
				"sfeFallback": false,
				"tier2SkipReason": null
			}
		},
		{
			"id": "no-text-no-fallback",
			"description": "No strings at all: still skipped.",
			"requiresTier2": true,
			"input": {
				"payload": {
					"count": 3,
					"ok": true
				},
				"dropKeys": [
					"*"
				]
			},
			"expect": {
				"allowed": true,
				"fieldsDropped": [],
				"sfeFallback": false,
				"tier2SkipReason": "No strings extracted from tool result"
			}
		},
		{
			"id": "word-joined-token-falls-back",
			"description": "A single ASCII token that joins 4+ words with - _ or + is scored.",
			"requiresTier2": true,
			"input": {
				"payload": {
					"notes": "please-review-the-attached-contract-before-friday"
				},
				"dropKeys": [
					"*"
				]
			},
			"expect": {
				"allowed": false,
				"fieldsDropped": [
					"notes"
				],
				"sfeFallback": true,
				"tier2SkipReason": null
			}
		},
		{
			"id": "single-tokens-no-fallback",
			"description": "Only single printable-ASCII tokens (IDs, URLs): no fallback, still skipped.",
			"requiresTier2": true,
			"input": {
				"payload": {
					"id": "rec_1",
					"url": "https://graph.microsoft.com/v1.0/$metadata#users('u1')/events",
					"host": "api.example.company.co.uk"
				},
				"dropKeys": [
					"*"
				]
			},
			"expect": {
				"allowed": true,
				"fieldsDropped": [
					"host",
					"id",
					"url"
				],
				"sfeFallback": false,
				"tier2SkipReason": "No strings extracted from tool result"
			}
		},
		{
			"id": "whitespace-only-no-fallback",
			"description": "A whitespace-only string is not scored.",
			"requiresTier2": true,
			"input": {
				"payload": {
					"notes": "                    "
				},
				"dropKeys": [
					"*"
				]
			},
			"expect": {
				"allowed": true,
				"fieldsDropped": [
					"notes"
				],
				"sfeFallback": false,
				"tier2SkipReason": "No strings extracted from tool result"
			}
		},
		{
			"id": "dropped-prose-kept",
			"description": "A value with 3+ words is kept even when SFE drops its field, so there is nothing to fall back for.",
			"requiresTier2": true,
			"input": {
				"payload": {
					"id": "rec_1",
					"ref": "Please review the attached contract before Friday."
				},
				"dropKeys": [
					"*"
				]
			},
			"expect": {
				"allowed": false,
				"fieldsDropped": [
					"id"
				],
				"sfeFallback": false,
				"tier2SkipReason": null
			}
		}
	]
}
